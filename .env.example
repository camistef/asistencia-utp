# Copia este archivo como ".env" y ajusta los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Puerto del servidor web
PORT=3000

# Conexión a MySQL / MariaDB (XAMPP usa root sin contraseña por defecto)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asistencia_utp

# Clave para firmar la cookie de sesión. Cámbiala por un texto largo y aleatorio.
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-secreta

# Minutos de inactividad antes de que la sesión expire
SESSION_MINUTOS=60

# Ruta a mysqldump (para el script de respaldo). Ruta típica en XAMPP:
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
