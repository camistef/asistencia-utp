<%- include('partials/head', { claseBody: 'pagina-login' }) %>

<section class="login-caja">
  <div class="login-encabezado">
    <span class="marca-icono grande" aria-hidden="true">✓</span>
    <h1>Asistencia UTP</h1>
    <p>Registro de asistencia con tarjeta universitaria</p>
  </div>

  <form method="post" action="/login" class="formulario" autocomplete="on">
    <label for="usuario">Usuario</label>
    <input type="text" id="usuario" name="usuario" value="<%= usuarioEscrito %>"
           required maxlength="50" autocomplete="username" autofocus>

    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" required maxlength="72" autocomplete="current-password">

    <button type="submit" class="btn btn-primario btn-bloque">Entrar</button>
  </form>

  <p class="nota">Acceso solo para docentes y administración.<br>
    Los alumnos registran su asistencia pasando la tarjeta en el lector del aula.</p>
</section>

<%- include('partials/foot') %>
