<%- include('../partials/head') %>

<div class="titulo-acciones">
  <h1>Docentes y cuentas</h1>
  <a class="btn btn-primario" href="/admin/docentes/nuevo">+ Nueva cuenta</a>
</div>

<div class="tabla-contenedor">
<table class="tabla">
  <thead><tr><th>Nombre</th><th>Usuario</th><th>Rol</th><th>Materias asignadas</th><th>Estado</th><th></th></tr></thead>
  <tbody>
  <% usuarios.forEach(u => { %>
    <tr class="<%= u.activo ? '' : 'inactivo' %>">
      <td><%= u.nombre %></td>
      <td class="mono"><%= u.usuario %></td>
      <td><%= u.rol === 'admin' ? 'Administrador' : 'Docente' %></td>
      <td><%= u.rol === 'admin' ? '—' : u.total_asignaciones %></td>
      <td><span class="pastilla <%= u.activo ? 'pastilla-ok' : 'pastilla-gris' %>"><%= u.activo ? 'Activa' : 'Desactivada' %></span></td>
      <td class="acciones-fila">
        <a class="btn btn-sm" href="/admin/docentes/<%= u.id %>/editar">Editar</a>
        <% if (u.id !== usuario.id) { %>
        <form method="post" action="/admin/docentes/<%= u.id %>/estado">
          <button class="btn btn-sm btn-claro" type="submit"><%= u.activo ? 'Desactivar' : 'Activar' %></button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<p class="nota">Una cuenta desactivada no puede iniciar sesión, pero su historial se conserva.</p>

<%- include('../partials/foot') %>
