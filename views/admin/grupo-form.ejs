<%- include('../partials/head') %>

<h1><%= titulo %></h1>

<form method="post" action="/admin/grupos<%= grupo.id ? '/' + grupo.id : '' %>" class="tarjeta formulario">
  <label for="nombre">Nombre del grupo *</label>
  <input type="text" id="nombre" name="nombre" value="<%= grupo.nombre %>" required maxlength="30"
         placeholder="Ej. TI-1A" autofocus>

  <label for="carrera">Carrera *</label>
  <input type="text" id="carrera" name="carrera" value="<%= grupo.carrera %>" required maxlength="100"
         placeholder="Ej. Tecnologías de la Información">

  <label for="cuatrimestre">Cuatrimestre *</label>
  <input type="number" id="cuatrimestre" name="cuatrimestre" value="<%= grupo.cuatrimestre %>" required min="1" max="11">

  <div class="acciones">
    <button type="submit" class="btn btn-primario">Guardar</button>
    <a href="/admin/grupos" class="btn btn-claro">Cancelar</a>
  </div>
</form>

<%- include('../partials/foot') %>
